// Loads the shared library defined in this repo (configure it in
// Jenkins > Manage Jenkins > System > Global Pipeline Libraries as
// "sample-shared-lib"). The trailing underscore imports all vars/ steps.
@Library('sample-shared-lib') _

pipeline {
    agent any

    // ---- Parameter set #1 : the "orders-service" build ----
    environment {
        // Optional: set defaults here if the var isn't already in the agent/job env
        APP_NAME    = "${env.APP_NAME ?: 'orders-service'}"
        BUILD_TOOL  = "${env.BUILD_TOOL ?: 'maven'}"
        ENVIRONMENT = "${env.ENVIRONMENT ?: 'dev'}"
        REPLICAS    = "${env.REPLICAS ?: '2'}"
    }

    stages {
        stage('Build') {
            steps {
                sayHello name: env.APP_NAME, greeting: 'Building'
                script {
                    buildApp(
                        appName    : env.APP_NAME,
                        buildTool  : env.BUILD_TOOL,
                        environment: env.ENVIRONMENT
                    )
                }
            }
        }

        stage('Test') {
            // One stage with both steps running in parallel.
            parallel {
                stage('Unit Tests') {
                    steps {
                        runTests appName: env.APP_NAME, suite: 'unit'
                    }
                }
                stage('Lint') {
                    steps {
                        runTests appName: env.APP_NAME, suite: 'lint'
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                deployApp(
                    appName    : env.APP_NAME,
                    environment: env.ENVIRONMENT,
                    replicas   : env.REPLICAS as Integer
                )
                sendNotification appName: env.APP_NAME, channel: '#orders'
            }
        }
    }
}
