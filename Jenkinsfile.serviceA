// Loads the shared library defined in this repo (configure it in
// Jenkins > Manage Jenkins > System > Global Pipeline Libraries as
// "sample-shared-lib"). The trailing underscore imports all vars/ steps.
@Library('sample-shared-lib') _

pipeline {
    agent any

    // ---- Parameter set #1 : the "orders-service" build ----
    parameters {
        string(name: 'APP_NAME',    defaultValue: 'orders-service', description: 'Application to build & deploy')
        choice(name: 'BUILD_TOOL',  choices: ['maven', 'gradle', 'npm'], description: 'Build tool to use')
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'production'], description: 'Target environment')
        string(name: 'REPLICAS',    defaultValue: '2', description: 'Number of replicas to deploy')
    }

    stages {
        stage('Build') {
            steps {
                sayHello name: params.APP_NAME, greeting: 'Building'
                script {
                    buildApp(
                        appName    : params.APP_NAME,
                        buildTool  : params.BUILD_TOOL,
                        environment: params.ENVIRONMENT
                    )
                }
            }
        }

        stage('Test') {
            // One stage with both steps running in parallel.
            parallel {
                stage('Unit Tests') {
                    steps {
                        runTests appName: params.APP_NAME, suite: 'unit'
                    }
                }
                stage('Lint') {
                    steps {
                        runTests appName: params.APP_NAME, suite: 'lint'
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                deployApp(
                    appName    : params.APP_NAME,
                    environment: params.ENVIRONMENT,
                    replicas   : params.REPLICAS as Integer
                )
                sendNotification appName: params.APP_NAME, channel: '#orders'
            }
        }
    }
}
